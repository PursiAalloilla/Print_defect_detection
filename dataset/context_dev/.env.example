# Context.dev API key (required for S1 discover, S2 fetch, S3 optional image classification, S4 download)
CONTEXT_DEV_API_KEY=

# Own LLM API credentials for S5 synthesis and S7 evaluation harness (OpenAI-compatible endpoint)
# Falls back to GEMINI_API_KEY, GOOGLE_API_KEY, or OPENAI_API_KEY if LLM_API_KEY is unset.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SYNTHESIS_MODEL=gemini-3.5-flash

# S7 evaluation harness defaults
EVAL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVAL_MODEL=gemini-3.5-flash-lite
JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
JUDGE_MODEL=gemini-pro-latest
